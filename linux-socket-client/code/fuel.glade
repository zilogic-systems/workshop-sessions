<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkWindow" id="main_window">
    <property name="title">UDP Fuel Gauge</property>
    <property name="default_width">300</property>
    <property name="default_height">250</property>
    <signal name="destroy" handler="on_main_window_destroy"/>

    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">15</property>
        <property name="margin">20</property>

        <child>
          <object class="GtkLabel">
            <property name="label">Fuel Level</property>
            <attributes>
              <attribute name="weight" value="bold"/>
              <attribute name="scale" value="1.5"/>
            </attributes>
          </object>
        </child>

        <child>
          <object class="GtkLabel" id="fuel_label">
            <property name="label">0%</property>
            <property name="justify">center</property>
            <attributes>
              <attribute name="weight" value="bold"/>
              <attribute name="scale" value="3.5"/>
            </attributes>
          </object>
        </child>

        <child>
          <object class="GtkLevelBar" id="fuel_levelbar">
            <property name="min-value">0</property>
            <property name="max-value">1</property>
            <property name="value">0</property>
            <property name="hexpand">True</property>
            <property name="orientation">horizontal</property>
          </object>
        </child>

      </object>
    </child>

  </object>
</interface>
